{
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": ["src/**/*.ts", "src/**/*.tsx", "../shared/src/utils.ts"],
  "compilerOptions": {
    "composite": true,
    "lib": ["es2020", "dom", "dom.iterable", "es2023.array"],
    "jsx": "react-jsx",
    "types": ["chrome", "react", "react-dom"],
    "outDir": "dist/packages/renderer",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/src/*"],
      "@packages/monaco": ["../monaco/src/index.ts"]
    }
  },
  "references": [
    {
      "path": "../shared"
    },
    {
      "path": "../monaco"
    }
  ]
}
