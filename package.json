{
  "name": "chrome-invert-userscripts-extension",
  "displayName": "Invert Userscripts",
  "version": "1.0.0",
  "description": "Flip the web upside down with Invert Userscripts, a Chrome extension that combines an integrated TypeScript/SCSS IDE and bundler for the browser, to manage, build, and inject JavaScript userscripts fast.",
  "author": "mattgoespro",
  "main": "index.js",
  "type": "module",
  "keywords": [
    "chrome",
    "extension",
    "userscripts",
    "typescript",
    "ide",
    "scss",
    "bundler",
    "developer tools"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "clean": "rm -rf dist && rm -rf node_modules/.cache",
    "lint": "eslint packages plugins examples",
    "test": "TS_NODE_PROJECT=tsconfig.tools.json NODE_OPTIONS='--import ./tests/register-aliases.mjs --loader ts-node/esm' node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "build:examples": "tsc -p examples/tsconfig.json",
    "e2e": "playwright test --headed",
    "e2e:headless": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@shikijs/core": "^3.22.0",
    "@shikijs/engine-javascript": "^3.22.0",
    "@shikijs/langs": "^3.22.0",
    "@shikijs/monaco": "^3.22.0",
    "@shikijs/themes": "^3.22.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query": "^5.94.5",
    "@types/redux-logger": "^3.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuzzysort": "^3.1.0",
    "lucide-react": "^0.563.0",
    "monaco-editor": "^0.55.1",
    "monaco-editor-core": "^0.55.1",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.0",
    "react-redux": "^9.2.0",
    "react-resizable-panels": "^4.6.5",
    "redux-logger": "^4.0.0",
    "sass": "^1.98.0",
    "shiki": "^3.22.0",
    "tailwindcss": "^4.2.1",
    "terser": "^5.46.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "^0.53.0",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.36",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.4.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "favicons": "^7.2.0",
    "favicons-webpack-plugin": "^6.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "fs-extra": "^11.3.3",
    "html-webpack-plugin": "^5.6.6",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "open": "^11.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "ws": "^8.19.0"
  },
  "packageManager": "pnpm@10.33.0"
}
